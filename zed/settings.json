// Converted from VSCode config
{
  // Core
  "ui_font_family": "FiraCode Nerd Font",
  "edit_predictions": {
    "provider": "zed"
  },
  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "agent_buffer_font_size": 16.5,
  "ui_font_weight": 600.0,
  "vim_mode": true,
  "base_keymap": "VSCode",

  // Font
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 16.5,
  "buffer_font_ligatures": true,
  "buffer_font_weight": 500,
  "ui_font_size": 16.0,

  // Appearance
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula Soft"
  },
  "theme_overrides": {
    "Ayu Mirage": {
      "syntax": {
        "comment": {
          "font_style": "italic",
          "color": "#808080"
        }
      }
    }
  },
  "minimap": { "show": "never" },
  "scrollbar": { "show": "auto" },
  "scroll_beyond_last_line": "off",
  "wrap_guides": [120],
  "colorize_brackets": true,
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "relative_line_numbers": "enabled",

  // Toolbar
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },

  // Tabs
  "preview_tabs": { "enabled": false },
  "tab_bar": { "show": true },

  // Search
  "use_smartcase_search": true,

  // Vim
  "vim": {
    "use_system_clipboard": "always",
    "use_multiline_find": true,
    "toggle_relative_line_numbers": true
  },

  // Files
  "file_types": {
    "dotenv": [".env*"]
  },
  "file_scan_exclusions": [
    ".idea",
    ".mypy_cache",
    ".vscode",
    "**/__pycache__",
    "**/.classpath",
    "**/.coverage",
    "**/.factorypath",
    "**/.history",
    "**/.project",
    "**/.settings",
    "**/*.pyc"
  ],

  // Layout
  "project_panel": { "dock": "left" },
  "terminal": { "dock": "bottom" }
}
