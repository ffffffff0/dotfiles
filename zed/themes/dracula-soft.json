{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dracula Soft",
  "author": "lihua (ported from VS Code Dracula Soft by Zeno Rocha)",
  "themes": [
    {
      "name": "Dracula Soft",
      "appearance": "dark",
      "style": {
        "accents": [
          "#bf9eeeff",
          "#f286c4ff",
          "#97e1f1ff",
          "#62e884ff",
          "#ffb86cff",
          "#e7ee98ff",
          "#ee6666ff"
        ],
        "background.appearance": "opaque",
        "background": "#282a36ff",
        "border": "#191a21ff",
        "border.variant": "#44475aff",
        "border.focused": "#bf9eeeff",
        "border.selected": "#bf9eeeff",
        "border.transparent": "#282a36ff",
        "border.disabled": "#7b7f8bff",
        "elevated_surface.background": "#262626ff",
        "surface.background": "#282a36ff",
        "element.background": "#343746ff",
