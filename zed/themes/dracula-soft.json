        "terminal.bright_foreground": "#ffffffff",
        "terminal.dim_foreground": "#7b7f8bff",
        "terminal.ansi.background": "#282a36ff",
        "terminal.ansi.black": "#262626ff",
        "terminal.ansi.bright_black": "#7b7f8bff",
        "terminal.ansi.dim_black": "#21222cff",
        "terminal.ansi.red": "#ee6666ff",
        "terminal.ansi.bright_red": "#f07c7cff",
        "terminal.ansi.dim_red": "#cc4444ff",
        "terminal.ansi.green": "#62e884ff",
        "terminal.ansi.bright_green": "#78f09aff",
        "terminal.ansi.dim_green": "#40c862ff",
        "terminal.ansi.yellow": "#e7ee98ff",
        "terminal.ansi.bright_yellow": "#f6f6aeff",
        "terminal.ansi.dim_yellow": "#c1c870ff",
        "terminal.ansi.blue": "#bf9eeeff",
        "terminal.ansi.bright_blue": "#d6b4f7ff",
        "terminal.ansi.dim_blue": "#7766ccff",
        "terminal.ansi.magenta": "#f286c4ff",
        "terminal.ansi.bright_magenta": "#f49ddaff",
        "terminal.ansi.dim_magenta": "#cc619eff",
        "terminal.ansi.cyan": "#97e1f1ff",
        "terminal.ansi.bright_cyan": "#adf6f6ff",
        "terminal.ansi.dim_cyan": "#6fbacaff",
        "terminal.ansi.white": "#f6f6f4ff",
        "terminal.ansi.bright_white": "#ffffffff",
        "terminal.ansi.dim_white": "#c6c6c2ff",
        "vim.normal.background": "#97e1f1ff",
        "vim.insert.background": "#62e884ff",
        "vim.replace.background": "#ee6666ff",
        "vim.visual.background": "#bf9eeeff",
        "vim.visual_line.background": "#bf9eeeff",
        "vim.visual_block.background": "#bf9eeeff",
        "vim.helix_normal.background": "#97e1f1ff",
        "vim.helix_select.background": "#62e884ff",
        "vim.mode.text": "#282a36ff"
