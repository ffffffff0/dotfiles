          { "cursor": "#e7ee98ff", "background": "#e7ee98ff", "selection": "#e7ee9833" },
          { "cursor": "#97e1f1ff", "background": "#97e1f1ff", "selection": "#97e1f133" },
          { "cursor": "#ffb86cff", "background": "#ffb86cff", "selection": "#ffb86c33" },
          { "cursor": "#ee6666ff", "background": "#ee6666ff", "selection": "#ee666633" }
