          "preproc":         { "color": "#7b7f8bff" },
          "primary":         { "color": "#f6f6f4ff" },
          "property":        { "color": "#97e1f1ff" },
          "punctuation":            { "color": "#f286c4ff" },
          "punctuation.bracket":    { "color": "#f6f6f4ff" },
