          "string.regex":          { "color": "#ee6666ff" },
          "string.special":        { "color": "#f286c4ff" },
          "string.special.symbol": { "color": "#bf9eeeff" },
          "tag":            { "color": "#f286c4ff" },
          "text.literal":   { "color": "#62e884ff" },
          "title":          { "color": "#bf9eeeff", "font_weight": 600 },
          "type":           { "color": "#97e1f1ff" },
